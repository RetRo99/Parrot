---
import LegalPage from '../layouts/LegalPage.astro';
import { contactHref, site } from '../config';
const sections = [{ id: 'operator', text: '1. Operator' }, { id: 'policies-and-requests', text: '2. Policies and requests' }];
---
<LegalPage title="Legal notice" lead="Who operates Parrot and Parrot Cloud." sections={sections} description="Publisher and contact information for Parrot and Parrot Cloud.">
  <div class="legal-prose numbered-prose">
    <p>[CONFIRM legal operator identity and applicable business disclosure requirements. Lunaria is the publisher brand; legal operator identity remains deferred.]</p>
    <section aria-labelledby="operator"><h2 id="operator">Operator</h2>
    <p>{site.legalName}<br />{site.address}</p>
    <p>Contact: <a href={contactHref}>{site.supportEmail}</a></p>
    <p>[CONFIRM registration number, register, VAT details and other mandatory disclosures if applicable; omit only after confirming they are not required.]</p>
    </section><section aria-labelledby="policies-and-requests"><h2 id="policies-and-requests">Policies and requests</h2>
    <ul><li><a href="/privacy">Privacy policy</a></li><li><a href="/terms">Terms of use</a></li><li><a href="/delete-account">Account deletion</a></li><li><a href="/copyright">Copyright and abuse</a></li></ul>
    <p>Parrot is an independent project and is not affiliated with Storyteller or Audiobookshelf.</p>
    </section>
  </div>
</LegalPage>
