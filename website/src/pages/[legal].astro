---
import LegalPage from '../layouts/LegalPage.astro';
import { loadLegal } from '../lib/legal';
export function getStaticPaths() {
  return ['privacy', 'terms'].map(legal => ({ params: { legal } }));
}
const kind = Astro.params.legal as 'privacy' | 'terms';
const document = loadLegal(kind);
const other = kind === 'privacy' ? { href: '/terms', text: 'Terms of use' } : { href: '/privacy', text: 'Privacy policy' };
---
<LegalPage title={document.title} sections={document.sections} description={kind === 'privacy' ? 'What Parrot knows about you, why, and how to remove it.' : 'The agreement between you and us when you use Parrot and Parrot Cloud.'}>
    <Fragment slot="lead" set:html={document.lead} />
    <Fragment slot="notices">
      {document.lastUpdated ? <p class="updated">Last updated: <time datetime={document.lastUpdated}>{document.lastUpdated}</time></p> : <p class="updated">Last updated: [LAST UPDATED — set lastUpdated in the source front matter]</p>}
      <div class="legal-notices" set:html={document.notices} />
    </Fragment>
    <a slot="toc-extra" class="text-action" href={other.href}>{other.text} →</a>
    <section class="short-version card" aria-labelledby="short-version"><h2 id="short-version">The short version</h2><div set:html={document.short} /></section><div class="legal-prose" set:html={document.body} />
</LegalPage>
