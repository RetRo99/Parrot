---
import { Image } from 'astro:assets';
import logo from '../assets/logo-crop.webp';
import { earlyAccessHref, site } from '../config';
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/email-links.css';
interface Props { title?: string; description: string }
const { title, description } = Astro.props;
const pageTitle = title ? `${title} · Parrot` : 'Parrot · Read it. Hear it. Keep your place.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <Fragment set:html="<!--email_off-->" />
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Parrot home">
          <Image src={logo} alt="" width={72} height={72} format="webp" />
          <span>Parrot</span>
        </a>
        <nav aria-label="Main navigation">
          <a class="desktop-nav" href="/#features">Features</a>
          <a class="desktop-nav" href="/#cloud">Parrot Cloud</a>
          <a class="desktop-nav" href="/support" aria-current={Astro.url.pathname === '/support' ? 'page' : undefined}>Support</a>
          <a class="button" href={earlyAccessHref}>Early access</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a class="brand" href="/" aria-label="Parrot home">
            <Image src={logo} alt="" width={56} height={56} format="webp" />
            <span>Parrot</span>
          </a>
          <p>© 2026 {site.legalName}, Slovenia</p>
          <p class="small">Not affiliated with Storyteller or Audiobookshelf.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/privacy">Privacy policy</a>
          <a href="/terms">Terms of use</a>
          <a href="/support">Support</a>
          <a href="/delete-account">Delete your account</a>
          <a href="/copyright">Copyright and abuse</a>
          <a href="/legal-notice">Legal notice</a>
        </nav>
      </div>
    </footer>
    <Fragment set:html="<!--/email_off-->" />
  </body>
</html>
