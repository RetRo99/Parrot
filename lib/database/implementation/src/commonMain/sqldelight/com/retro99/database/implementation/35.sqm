CREATE TABLE IF NOT EXISTS library_group_decision_log (
    profile_id TEXT NOT NULL,
    decision_id TEXT NOT NULL,
    server_revision INTEGER NOT NULL DEFAULT 0 CHECK (server_revision >= 0),
    payload TEXT NOT NULL,
    created_at TEXT NOT NULL,
    feed_applied INTEGER NOT NULL DEFAULT 0 CHECK (feed_applied IN (0, 1)),
    PRIMARY KEY (profile_id, decision_id)
);

CREATE INDEX IF NOT EXISTS idx_library_group_decisions_revision
ON library_group_decision_log(profile_id, server_revision);

CREATE TABLE IF NOT EXISTS library_group_metadata_preferences (
    profile_id TEXT NOT NULL,
    group_id TEXT NOT NULL,
    source_key TEXT NOT NULL,
    decision_id TEXT NOT NULL,
    server_revision INTEGER NOT NULL DEFAULT 0 CHECK (server_revision >= 0),
    PRIMARY KEY (profile_id, group_id),
    FOREIGN KEY (profile_id, group_id)
        REFERENCES library_groups(profile_id, group_id) ON DELETE CASCADE
);
