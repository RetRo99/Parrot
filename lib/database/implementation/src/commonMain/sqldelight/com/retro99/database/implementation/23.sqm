CREATE TABLE IF NOT EXISTS sync_checkpoints (
    destination_id TEXT NOT NULL,
    remote_account_id TEXT NOT NULL,
    cursor TEXT,
    updated_at TEXT NOT NULL,
    PRIMARY KEY (destination_id, remote_account_id)
);

ALTER TABLE sync_checkpoints ADD COLUMN status TEXT;
ALTER TABLE sync_checkpoints ADD COLUMN pending_mutation_count INTEGER NOT NULL DEFAULT 0;
ALTER TABLE sync_checkpoints ADD COLUMN last_successful_at TEXT;
ALTER TABLE sync_checkpoints ADD COLUMN last_error TEXT;
