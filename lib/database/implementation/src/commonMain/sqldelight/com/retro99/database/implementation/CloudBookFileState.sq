CREATE TABLE IF NOT EXISTS cloud_book_file_state (
    library_book_id TEXT NOT NULL,
    cloud_book_id TEXT NOT NULL,
    cloud_book_file_id TEXT NOT NULL,
    media_type TEXT NOT NULL,
    relative_path TEXT NOT NULL DEFAULT '',
    file_name TEXT NOT NULL,
    status TEXT NOT NULL,
    size_bytes INTEGER NOT NULL,
    content_hash TEXT NOT NULL,
    content_hash_algorithm TEXT NOT NULL,
    remote_revision INTEGER NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY (library_book_id, media_type, relative_path)
);

CREATE INDEX IF NOT EXISTS idx_cloud_book_file_state_book
ON cloud_book_file_state(library_book_id);

upsertCloudBookFileState:
INSERT OR REPLACE INTO cloud_book_file_state(
    library_book_id, cloud_book_id, cloud_book_file_id, media_type, relative_path,
    file_name, status, size_bytes, content_hash, content_hash_algorithm, remote_revision, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);


getCloudBookFileStates:
SELECT * FROM cloud_book_file_state WHERE library_book_id = ?;

observeAllCloudBookFileStates:
SELECT * FROM cloud_book_file_state ORDER BY updated_at DESC;

deleteCloudBookFileState:
DELETE FROM cloud_book_file_state
WHERE library_book_id = ? AND media_type = ? AND relative_path = ?;

deleteCloudBookFileStateByCloudBookFileId:
DELETE FROM cloud_book_file_state
WHERE library_book_id = ? AND cloud_book_file_id = ?;

deleteAllCloudBookFileStates:
DELETE FROM cloud_book_file_state;

CREATE TABLE IF NOT EXISTS pending_cloud_book_file_feed_changes (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    cloud_book_id TEXT NOT NULL,
    feed_revision INTEGER,
    payload_json TEXT NOT NULL,
    received_at TEXT NOT NULL,
    UNIQUE (cloud_book_id, payload_json)
);

CREATE INDEX IF NOT EXISTS idx_pending_cloud_book_file_feed_changes_book
ON pending_cloud_book_file_feed_changes(cloud_book_id, feed_revision, id);

enqueuePendingCloudBookFileFeedChange:
INSERT OR IGNORE INTO pending_cloud_book_file_feed_changes(
    cloud_book_id, feed_revision, payload_json, received_at
) VALUES (?, ?, ?, ?);

getPendingCloudBookFileFeedChange:
SELECT * FROM pending_cloud_book_file_feed_changes
WHERE cloud_book_id = ? AND payload_json = ?;

getPendingCloudBookFileFeedChanges:
SELECT * FROM pending_cloud_book_file_feed_changes
WHERE cloud_book_id = ?
ORDER BY CASE WHEN feed_revision IS NULL THEN 1 ELSE 0 END, feed_revision, id;

getPendingCloudBookFileFeedCloudBookIds:
SELECT DISTINCT cloud_book_id FROM pending_cloud_book_file_feed_changes ORDER BY cloud_book_id;

deletePendingCloudBookFileFeedChange:
DELETE FROM pending_cloud_book_file_feed_changes WHERE id = ?;

deleteAllPendingCloudBookFileFeedChanges:
DELETE FROM pending_cloud_book_file_feed_changes;
