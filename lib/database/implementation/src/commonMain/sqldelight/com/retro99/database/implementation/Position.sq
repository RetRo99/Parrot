-- ============================================
-- POSITION TABLE
-- ============================================

CREATE TABLE IF NOT EXISTS position (
    book_uuid TEXT NOT NULL PRIMARY KEY,
    library_book_id TEXT,
    local_generation INTEGER NOT NULL DEFAULT 0,
    remote_revision INTEGER,
    timestamp INTEGER,
    created_at TEXT,
    updated_at TEXT,
    locator_href TEXT,
    locator_type TEXT,
    locator_title TEXT,
    locator_target INTEGER,
    css_selector TEXT,
    audio_timestamp_ms INTEGER,
    chapter_index INTEGER,
    progression REAL,
    total_chapters INTEGER,
    total_duration_ms INTEGER,
    total_progression REAL,
    position INTEGER
);

CREATE INDEX IF NOT EXISTS idx_position_updated ON position(updated_at);
CREATE INDEX IF NOT EXISTS idx_position_progression ON position(progression);
CREATE INDEX IF NOT EXISTS idx_position_library_book ON position(library_book_id);

CREATE TABLE IF NOT EXISTS remote_position (
    book_uuid TEXT NOT NULL PRIMARY KEY,
    library_book_id TEXT,
    remote_revision INTEGER,
    timestamp INTEGER,
    created_at TEXT,
    updated_at TEXT,
    locator_href TEXT,
    locator_type TEXT,
    locator_title TEXT,
    locator_target INTEGER,
    css_selector TEXT,
    audio_timestamp_ms INTEGER,
    chapter_index INTEGER,
    progression REAL,
    total_chapters INTEGER,
    total_duration_ms INTEGER,
    total_progression REAL,
    position INTEGER
);

-- Queries
upsertPosition:
INSERT OR REPLACE INTO position(
    book_uuid, library_book_id, local_generation, remote_revision, timestamp, created_at, updated_at,
    locator_href, locator_type, locator_title, locator_target, css_selector,
    audio_timestamp_ms, chapter_index, progression, total_chapters,
    total_duration_ms, total_progression, position
)
-- library_book_id is the book id only for books in your library (I4), NULL otherwise.
VALUES (
    ?,
    (SELECT lb.library_book_id FROM library_books lb WHERE lb.library_book_id = ?),
    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?
);

linkPositionToLibraryBook:
UPDATE position SET library_book_id = book_uuid
WHERE book_uuid = ? AND library_book_id IS NULL;

updateRemoteRevision:
UPDATE position SET remote_revision = ? WHERE book_uuid = ?;

updateRemoteRevisionIfGeneration:
UPDATE position SET remote_revision = ?
WHERE book_uuid = ? AND local_generation = ?;

upsertRemotePosition:
INSERT OR REPLACE INTO remote_position(
    book_uuid, library_book_id, remote_revision, timestamp, created_at, updated_at,
    locator_href, locator_type, locator_title, locator_target, css_selector,
    audio_timestamp_ms, chapter_index, progression, total_chapters,
    total_duration_ms, total_progression, position
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getRemotePositionByBookUuid:
SELECT * FROM remote_position WHERE book_uuid = ?;

deleteRemotePosition:
DELETE FROM remote_position WHERE book_uuid = ?;

getPositionByBookUuid:
SELECT * FROM position WHERE book_uuid = ?;

getPositionByLibraryBookId:
SELECT * FROM position WHERE library_book_id = ?
ORDER BY updated_at DESC, remote_revision DESC
LIMIT 1;

getAllPositions:
SELECT * FROM position ORDER BY updated_at DESC;

getRecentlyReadBooks:
SELECT b.*, p.progression, p.total_progression, p.updated_at FROM books b
JOIN position p ON b.uuid = p.book_uuid
ORDER BY p.updated_at DESC
LIMIT ?;

getBooksInProgress:
SELECT b.*, p.progression, p.total_progression, p.updated_at FROM books b
JOIN position p ON b.uuid = p.book_uuid
WHERE p.progression > 0 AND (p.total_progression IS NULL OR p.total_progression < 1.0)
ORDER BY p.updated_at DESC;

getCompletedBooks:
SELECT b.*, p.progression, p.total_progression, p.updated_at FROM books b
JOIN position p ON b.uuid = p.book_uuid
WHERE p.total_progression >= 1.0
ORDER BY p.updated_at DESC;

deletePosition:
DELETE FROM position WHERE book_uuid = ?;

deleteAllPositions:
DELETE FROM position;

deleteAllRemotePositions:
DELETE FROM remote_position;

moveBookPosition:
UPDATE position SET book_uuid = ?, library_book_id = ? WHERE book_uuid = ?;
