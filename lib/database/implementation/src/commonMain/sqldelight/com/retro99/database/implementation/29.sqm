-- Progress across linked copies (project 3). Where each position came from, when the
-- reading happened, and a short text anchor for ebook positions. Local only.
ALTER TABLE position ADD COLUMN origin TEXT NOT NULL DEFAULT 'user';
ALTER TABLE position ADD COLUMN observed_at TEXT;
ALTER TABLE position ADD COLUMN text_anchor TEXT;

-- The latest write this device made into each linked copy (one row per target copy), so a
-- pulled position can be recognised as an echo of our own write (§1.4, guards 1, 2 and 6).
CREATE TABLE linked_copy_writes (
    target_key TEXT NOT NULL PRIMARY KEY,
    target_book_uuid TEXT NOT NULL,
    source_key TEXT,
    source_observed_at TEXT,
    written_at TEXT NOT NULL,
    marker TEXT,
    locator_href TEXT,
    progression REAL,
    total_progression REAL,
    audio_ms INTEGER
);

CREATE INDEX idx_linked_copy_writes_book ON linked_copy_writes(target_book_uuid);
