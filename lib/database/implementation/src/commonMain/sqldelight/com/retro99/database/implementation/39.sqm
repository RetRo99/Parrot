-- Book catalogues: downloads in progress, where acquired books came from, and saved pages.
CREATE TABLE IF NOT EXISTS catalogue_acquisitions (
    request_id TEXT NOT NULL PRIMARY KEY,
    source_id TEXT NOT NULL,
    publication_key TEXT NOT NULL,
    detail_identity TEXT,
    detail_url TEXT,
    representation_key TEXT NOT NULL,
    title TEXT NOT NULL,
    author TEXT,
    cover_reference TEXT,
    catalogue_name TEXT NOT NULL,
    state TEXT NOT NULL,
    queue_position INTEGER NOT NULL,
    staging_path TEXT,
    expected_size_bytes INTEGER,
    bytes_so_far INTEGER NOT NULL DEFAULT 0,
    local_hash TEXT,
    library_book_id TEXT,
    failure_reason TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    completed_at INTEGER,
    attempts INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_catalogue_acquisitions_queue
ON catalogue_acquisitions(state, queue_position);

CREATE INDEX IF NOT EXISTS idx_catalogue_acquisitions_request
ON catalogue_acquisitions(source_id, publication_key, representation_key);

CREATE TABLE IF NOT EXISTS catalogue_book_sources (
    id TEXT NOT NULL PRIMARY KEY,
    library_book_id TEXT NOT NULL,
    source_id TEXT NOT NULL,
    catalogue_name TEXT NOT NULL,
    catalogue_origin TEXT NOT NULL,
    publication_key TEXT NOT NULL,
    detail_identity TEXT,
    selected_format TEXT NOT NULL,
    rights_text TEXT,
    catalogue_updated TEXT,
    content_hash TEXT NOT NULL,
    acquired_at INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_catalogue_book_sources_publication
ON catalogue_book_sources(source_id, publication_key);

CREATE INDEX IF NOT EXISTS idx_catalogue_book_sources_book
ON catalogue_book_sources(library_book_id);

CREATE TABLE IF NOT EXISTS catalogue_documents (
    source_id TEXT NOT NULL,
    access_generation INTEGER NOT NULL,
    request_url TEXT NOT NULL,
    content_type TEXT,
    etag TEXT,
    last_modified TEXT,
    stored_at INTEGER NOT NULL,
    payload BLOB NOT NULL,
    size_bytes INTEGER NOT NULL,
    PRIMARY KEY (source_id, access_generation, request_url)
);

CREATE INDEX IF NOT EXISTS idx_catalogue_documents_stored
ON catalogue_documents(stored_at);

