CREATE TABLE IF NOT EXISTS sync_outbox (
    local_mutation_sequence INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    mutation_id TEXT NOT NULL UNIQUE,
    cloud_user_id TEXT,
    entity_type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    operation TEXT NOT NULL,
    payload TEXT NOT NULL,
    base_revision INTEGER,
    local_generation INTEGER NOT NULL DEFAULT 0,
    state TEXT NOT NULL DEFAULT 'pending',
    created_at TEXT NOT NULL,
    attempt_count INTEGER NOT NULL DEFAULT 0,
    next_attempt_at TEXT,
    last_error TEXT
);

CREATE INDEX IF NOT EXISTS idx_sync_outbox_entity
ON sync_outbox(entity_type, entity_id);

enqueueMutation:
INSERT INTO sync_outbox(
    mutation_id,
    cloud_user_id,
    entity_type,
    entity_id,
    operation,
    payload,
    base_revision,
    local_generation,
    state,
    created_at,
    attempt_count,
    next_attempt_at,
    last_error
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

bindUnassignedMutations:
UPDATE sync_outbox
SET cloud_user_id = ?
WHERE cloud_user_id IS NULL;

getPendingMutations:
SELECT * FROM sync_outbox
WHERE cloud_user_id = ?
ORDER BY local_mutation_sequence ASC;

getEligibleMutations:
SELECT * FROM sync_outbox
WHERE cloud_user_id = ?
AND state IN ('pending', 'dispatched')
AND (next_attempt_at IS NULL OR next_attempt_at <= ?)
ORDER BY local_mutation_sequence ASC;

getPendingIncludingUnassigned:
SELECT * FROM sync_outbox
WHERE cloud_user_id = ? OR cloud_user_id IS NULL
ORDER BY local_mutation_sequence ASC;

markMutationDispatched:
UPDATE sync_outbox
SET state = 'dispatched'
WHERE mutation_id = ?;

markMutationConflict:
UPDATE sync_outbox
SET state = 'conflict_preserved',
    last_error = ?
WHERE mutation_id = ?;

updateBaseRevision:
UPDATE sync_outbox
SET base_revision = ?
WHERE mutation_id = ?;

recordMutationFailure:
UPDATE sync_outbox
SET attempt_count = attempt_count + 1,
    next_attempt_at = ?,
    last_error = ?
WHERE mutation_id = ?;

deletePendingMutationsForEntity:
DELETE FROM sync_outbox
WHERE cloud_user_id IS ?
AND entity_type = ?
AND entity_id = ?
AND state = 'pending';

deletePendingMutationsForEntityAnyUser:
DELETE FROM sync_outbox
WHERE entity_type = ?
AND entity_id = ?
AND state = 'pending';

deleteMutation:
DELETE FROM sync_outbox WHERE mutation_id = ?;

deleteMutationsByEntityType:
DELETE FROM sync_outbox WHERE entity_type = ?;

deleteAllMutations:
DELETE FROM sync_outbox;

getAllMutations:
SELECT * FROM sync_outbox ORDER BY local_mutation_sequence ASC;

rewriteMutation:
UPDATE sync_outbox SET entity_id = ?, payload = ? WHERE mutation_id = ?;
