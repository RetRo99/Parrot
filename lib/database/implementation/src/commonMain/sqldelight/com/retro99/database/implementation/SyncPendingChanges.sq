CREATE TABLE IF NOT EXISTS sync_pending_changes (
    cloud_user_id TEXT NOT NULL,
    change_id INTEGER NOT NULL,
    entity_type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    operation TEXT NOT NULL,
    payload TEXT NOT NULL,
    revision INTEGER NOT NULL,
    created_at TEXT NOT NULL,
    PRIMARY KEY (cloud_user_id, change_id)
);

upsertPendingChange:
INSERT OR REPLACE INTO sync_pending_changes(
    cloud_user_id,
    change_id,
    entity_type,
    entity_id,
    operation,
    payload,
    revision,
    created_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getPendingChanges:
SELECT * FROM sync_pending_changes
WHERE cloud_user_id = ?
ORDER BY change_id ASC;

deletePendingChange:
DELETE FROM sync_pending_changes
WHERE cloud_user_id = ? AND change_id = ?;

deleteAllPendingChanges:
DELETE FROM sync_pending_changes;
