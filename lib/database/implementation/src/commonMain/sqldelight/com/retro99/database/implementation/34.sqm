ALTER TABLE session_recap ADD COLUMN cloud_account_id TEXT;
ALTER TABLE session_recap ADD COLUMN cloud_book_id TEXT;
ALTER TABLE session_recap ADD COLUMN consent_version INTEGER NOT NULL DEFAULT 2;
ALTER TABLE session_recap ADD COLUMN cloud_change_id INTEGER NOT NULL DEFAULT 0;
ALTER TABLE session_recap ADD COLUMN cloud_expires_at INTEGER;
ALTER TABLE session_recap ADD COLUMN cloud_identity_bound INTEGER NOT NULL DEFAULT 0;
-- No historical text may silently acquire the new storage consent.
UPDATE session_recap SET consent_version=0, excerpt=NULL, last_sentence=NULL,
 status=CASE WHEN status IN ('CAPTURING','PENDING','RUNNING','FAILED_RETRYABLE') THEN 'FAILED_PERMANENT' ELSE status END,
 last_error=CASE WHEN status IN ('CAPTURING','PENDING','RUNNING','FAILED_RETRYABLE') THEN 'CONSENT_WITHDRAWN' ELSE last_error END;
CREATE TABLE recap_cloud_delete (account_id TEXT NOT NULL, session_id TEXT NOT NULL, PRIMARY KEY(account_id,session_id));
CREATE TABLE recap_cloud_withdrawal (account_id TEXT NOT NULL PRIMARY KEY, pending INTEGER NOT NULL DEFAULT 1);
CREATE TABLE recap_cloud_cursor (account_id TEXT NOT NULL, book_id TEXT NOT NULL, cursor INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(account_id,book_id));
