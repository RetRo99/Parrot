CREATE TABLE IF NOT EXISTS library_source_resources (
    resource_id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    profile_id TEXT NOT NULL,
    source_key TEXT NOT NULL,
    native_resource_id TEXT NOT NULL,
    revision_present INTEGER NOT NULL CHECK (revision_present IN (0, 1)),
    revision_value TEXT NOT NULL,
    UNIQUE (profile_id, source_key, native_resource_id, revision_present, revision_value),
    UNIQUE (profile_id, resource_id),
    CHECK (revision_present = 1 OR revision_value = '')
);

CREATE TABLE IF NOT EXISTS library_identity_evidence (
    profile_id TEXT NOT NULL,
    evidence_id TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('book_fingerprint', 'fingerprint', 'transfer', 'certified')),
    source_resource_id INTEGER,
    source_book_key TEXT,
    destination_resource_id INTEGER,
    transfer_id TEXT,
    algorithm TEXT,
    content_hash TEXT,
    fingerprint_scope TEXT,
    fingerprint_verification TEXT,
    certified_namespace TEXT,
    certified_identity TEXT,
    certified_kind TEXT,
    provenance_kind TEXT NOT NULL,
    provenance_id TEXT NOT NULL,
    observed_at TEXT NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1 CHECK (is_active IN (0, 1)),
    PRIMARY KEY (profile_id, evidence_id),
    FOREIGN KEY (profile_id, source_resource_id)
        REFERENCES library_source_resources(profile_id, resource_id),
    FOREIGN KEY (profile_id, destination_resource_id)
        REFERENCES library_source_resources(profile_id, resource_id),
    CHECK (
        (kind = 'book_fingerprint' AND source_resource_id IS NULL
            AND source_book_key IS NOT NULL AND source_book_key <> ''
            AND destination_resource_id IS NULL AND transfer_id IS NULL
            AND content_hash IS NOT NULL AND content_hash <> ''
            AND fingerprint_scope IS NOT NULL AND fingerprint_verification IS NOT NULL
            AND certified_namespace IS NULL AND certified_identity IS NULL
            AND certified_kind IS NULL)
        OR (kind = 'fingerprint' AND source_resource_id IS NOT NULL
            AND source_book_key IS NULL AND destination_resource_id IS NULL
            AND transfer_id IS NULL AND content_hash IS NOT NULL
            AND content_hash <> '' AND fingerprint_scope IS NOT NULL
            AND fingerprint_verification IS NOT NULL AND certified_namespace IS NULL
            AND certified_identity IS NULL AND certified_kind IS NULL)
        OR (kind = 'transfer' AND source_resource_id IS NOT NULL
            AND source_book_key IS NULL AND destination_resource_id IS NOT NULL
            AND transfer_id IS NOT NULL AND transfer_id <> ''
            AND algorithm IS NULL AND content_hash IS NULL
            AND fingerprint_scope IS NULL AND fingerprint_verification IS NULL
            AND certified_namespace IS NULL AND certified_identity IS NULL
            AND certified_kind IS NULL)
        OR (kind = 'certified' AND source_resource_id IS NOT NULL
            AND source_book_key IS NULL AND destination_resource_id IS NULL
            AND transfer_id IS NULL AND algorithm IS NULL AND content_hash IS NULL
            AND fingerprint_scope IS NULL AND fingerprint_verification IS NULL
            AND certified_namespace IS NOT NULL AND certified_namespace <> ''
            AND certified_identity IS NOT NULL AND certified_identity <> ''
            AND certified_kind IS NOT NULL)
    )
);

CREATE INDEX IF NOT EXISTS idx_library_identity_evidence_active
ON library_identity_evidence(profile_id, is_active, kind);

insertLibrarySourceResource:
INSERT OR IGNORE INTO library_source_resources(
    profile_id, source_key, native_resource_id, revision_present, revision_value
) VALUES (?, ?, ?, ?, ?);

getLibrarySourceResource:
SELECT * FROM library_source_resources
WHERE profile_id = ? AND source_key = ? AND native_resource_id = ?
AND revision_present = ? AND revision_value = ?;

getLibrarySourceResourceById:
SELECT * FROM library_source_resources
WHERE profile_id = ? AND resource_id = ?;

getLibrarySourceResourcesForBook:
SELECT * FROM library_source_resources
WHERE profile_id = ? AND source_key = ?
ORDER BY native_resource_id, revision_present, revision_value;

insertLibraryIdentityEvidence:
INSERT INTO library_identity_evidence(
    profile_id, evidence_id, kind, source_resource_id, source_book_key,
    destination_resource_id,
    transfer_id, algorithm, content_hash, fingerprint_scope,
    fingerprint_verification, certified_namespace, certified_identity,
    certified_kind, provenance_kind, provenance_id, observed_at, is_active
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1);

getLibraryIdentityEvidence:
SELECT * FROM library_identity_evidence
WHERE profile_id = ? AND evidence_id = ?;

getActiveLibraryIdentityEvidence:
SELECT * FROM library_identity_evidence
WHERE profile_id = ? AND is_active = 1 ORDER BY observed_at, evidence_id;

retireLibraryIdentityEvidence:
UPDATE library_identity_evidence SET is_active = 0
WHERE profile_id = ? AND evidence_id = ?;
